<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<TextView
		android:id="@+id/qb_header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/qb_header"
		android:gravity="center"
		android:minHeight="48dp"
		android:paddingLeft="12dp"
		android:paddingRight="12dp"
		android:singleLine="true"
		android:text="@string/traditionalt9_settings"
		android:textColor="@color/qb_header_text"
		android:textSize="20sp"
		android:textStyle="bold" />

	<ListView
		android:id="@android:id/list"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:divider="@color/qb_divider"
		android:dividerHeight="1dp"
		android:drawSelectorOnTop="false"
		android:listSelector="@drawable/qb_list_selector"
		android:scrollbarAlwaysDrawVerticalTrack="true" />
</LinearLayout>
